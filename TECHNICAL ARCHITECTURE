10. Gemini AI Service
services/geminiService.js
const {
    GoogleGenerativeAI
} = require("@google/generative-ai");

const genAI = new GoogleGenerativeAI(
    process.env.GEMINI_API_KEY
);

const model = genAI.getGenerativeModel({
    model: "gemini-1.5-flash"
});

const generateAIContent = async (prompt) => {
    const result = await model.generateContent(prompt);

    const response = await result.response;

    return response.text();
};

const generateSummary = async (content) => {

    const prompt = `
    Summarize the following study material
    in simple and clear language.

    Study Material:
    ${content}
    `;

    return await generateAIContent(prompt);
};

const generateQuiz = async (content) => {

    const prompt = `
    Create 5 multiple-choice questions
    from the following study material.

    Provide:
    Question
    Four options
    Correct answer

    Study Material:
    ${content}
    `;

    return await generateAIContent(prompt);
};

const generateFlashcards = async (content) => {

    const prompt = `
    Create 5 study flashcards from the
    following material.

    Format:
    Question:
    Answer:

    Study Material:
    ${content}
    `;

    return await generateAIContent(prompt);
};

const generateStudyPlan = async (content) => {

    const prompt = `
    Create a simple personalized study plan
    based on the following study material.

    Include topics and suggested study sessions.

    Study Material:
    ${content}
    `;

    return await generateAIContent(prompt);
};

module.exports = {
    generateSummary,
    generateQuiz,
    generateFlashcards,
    generateStudyPlan
};

Note: Gemini model names and SDK usage can change over time, so use the currently supported Gemini model/API format for the API key and SDK version you install.

11. AI Controller
controllers/aiController.js
const StudyMaterial = require("../models/StudyMaterial");

const {
    generateSummary,
    generateQuiz,
    generateFlashcards,
    generateStudyPlan
} = require("../services/geminiService");

const getSummary = async (req, res) => {
    try {

        const material = await StudyMaterial.findOne({
            _id: req.params.id,
            userId: req.user.userId
        });

        if (!material) {
            return res.status(404).json({
                message: "Study material not found"
            });
        }

        const summary = await generateSummary(
            material.content
        );

        material.summary = summary;

        await material.save();

        res.json({
            summary
        });

    } catch (error) {
